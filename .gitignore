.vscode/settings.json
node_modules/
dist/
*.tsbuildinfo
*.log
*.mp4
design/
verification/

# Screenshot / diagnostic capture output (scripts/*.mjs write here)
screenshots/

# OS / editor junk
desktop.ini
.DS_Store
Thumbs.db

# NOTE on *.wasm: compiled WASM (public/release.wasm, public/cpp/*.wasm,
# build/cpp/*.wasm) is committed *intentionally* so the game and tests run
# without an emsdk/asc toolchain. Do not add a blanket *.wasm ignore.

# Python bytecode
__pycache__/
*.pyc

# Local C++ build metadata (regenerated by cmake / build-cpp.mjs).
# compile_commands.json embeds absolute paths — machine-specific, never commit it.
# public/cpp/build-info.json is the opposite: it is the COMMITTED provenance of
# the committed tetris_renderer.{js,wasm} (emcc version, port, flags, source hash,
# artifact sha256). It has no timestamps or absolute paths by design and is checked
# by scripts/verify-cpp-artifact.mjs. Only its build/cpp mirror is ignored.
cpp/compile_commands.json
build/cpp/build-info.json
build/cpp/compile_commands.json
build/cpp/*.o

# Generated from cpp/src/shaders/**/*.wgsl by scripts/generate-cpp-shaders.mjs —
# regenerated by every cpp:release/cpp:debug/CMake build, never hand-edited.
cpp/src/generated/
