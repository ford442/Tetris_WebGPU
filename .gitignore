.vscode/settings.json
node_modules/
dist/
*.tsbuildinfo
*.log
*.mp4
design/
verification/

# Screenshot / diagnostic capture output (scripts/*.mjs write here)
screenshots/

# OS / editor junk
desktop.ini
.DS_Store
Thumbs.db

# NOTE on *.wasm: compiled WASM (public/release.wasm, public/cpp/*.wasm) is committed
# *intentionally* so the game and tests run without an emsdk/asc toolchain. Do not add a
# blanket *.wasm ignore. The build/ directory is scratch output only (asc writes
# build/release.wasm and copies it to public/; build-cpp writes build/cpp/compile_commands.json)
# and is never tracked.
build/

# Local tool / editor / agent state — never commit
.idea/
.playwright-mcp/
*.pid
diff.txt

# Stray root-level texture copy: the canonical one is public/block.png.
/block.png
/public/block-2.png

# Python bytecode
__pycache__/
*.pyc

# Local C++ build metadata (regenerated by cmake / build-cpp.mjs).
# compile_commands.json embeds absolute paths — machine-specific, never commit it.
# public/cpp/build-info.json is the opposite: it is the COMMITTED provenance of
# the committed tetris_renderer.{js,wasm} (emcc version, port, flags, source hash,
# artifact sha256). It has no timestamps or absolute paths by design and is checked
# by scripts/verify-cpp-artifact.mjs.
cpp/compile_commands.json

# Generated from cpp/src/shaders/**/*.wgsl by scripts/generate-cpp-shaders.mjs —
# regenerated by every cpp:release/cpp:debug/CMake build, never hand-edited.
cpp/src/generated/

# Host doctest suite + CMake/Ninja build trees (npm run cpp:test:native; cpp/CMakeLists.txt).
# parity_vectors.h is generated from shared/cppParityVectors.json on every build.
cpp/tests/generated/

# Merge/patch leftovers
*.orig
*.rej
